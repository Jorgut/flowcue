{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowcue-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "MAC_SESSION", "class_name": "MacSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MacSession"] }
  ],
  "observability": { "enabled": true }
}
